ANTHROPIC_API_KEY=

# LLM backend: ollama (local) or anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# Role → local model (simulates Haiku / Sonnet / Opus)
# Haiku  = fast classify + routine FAQ
# Sonnet = high-severity answers
# Opus   = high + escalated (legal/HR) answers
CLASSIFIER_MODEL=llama3.2:latest
ANSWER_MODEL_ROUTINE=llama3.2:latest
ANSWER_MODEL_HIGH=mistral:latest
ANSWER_MODEL_OPUS=llama3.1:8b

# For Anthropic instead, set:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CLASSIFIER_MODEL=claude-haiku-4-5-20251001
# ANSWER_MODEL_ROUTINE=claude-haiku-4-5-20251001
# ANSWER_MODEL_HIGH=claude-sonnet-4-5-20250929
# ANSWER_MODEL_OPUS=claude-opus-4-20250514

SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.70
REDIS_URL=
CACHE_TTL_SECONDS=3600

RETRIEVAL_TOP_K=4
RETRIEVE_MAX_RETRIES=1
# Chroma L2 distance cutoff — farther chunks = not recognized in KB
RETRIEVAL_MAX_DISTANCE=1.15
# Reject ingest/promote when nearest KB doc is within this L2 distance
INGEST_DEDUP_MAX_DISTANCE=0.45
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

ESCALATE_DEPARTMENTS=legal,hr

# Auth — local JWT (change JWT_SECRET in any shared/deployed environment)
JWT_SECRET=dev-only-change-me-ampcus-helpdesk
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Bootstrap admin created only when data/users.json is empty
ADMIN_EMAIL=admin@ampcus.com
ADMIN_PASSWORD=ChangeMeAdmin1!
# Optional override; default is <chroma parent>/users.json
# USERS_PATH=./data/users.json
