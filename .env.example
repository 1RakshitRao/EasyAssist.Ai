# LLM backend: groq (default), grok, or anthropic — Ollama is not supported
LLM_PROVIDER=groq
GROQ_API_KEY=

# Groq tier models
# fast       = gpt-oss-20b  (classifier, scorer, NLP)
# balanced   = gpt-oss-120b (answers, doc summarization)
# powerful   = gpt-oss-120b (high + escalated answers)
# guardrails = prompt-guard  (Phase 9 safety checks)
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_BALANCED=openai/gpt-oss-120b
GROQ_MODEL_POWERFUL=openai/gpt-oss-120b
GROQ_MODEL_GUARDRAILS=llama-prompt-guard-2-86m

# For Grok instead, set:
# LLM_PROVIDER=grok
XAI_API_KEY=

# Grok tier models
# fast     = classifier, scorer, NLP, routine answers
# balanced = high-severity answers, document summarization
# powerful = high + escalated (legal/HR) answers
GROK_MODEL_FAST=grok-4.1-fast
GROK_MODEL_BALANCED=grok-4.3
GROK_MODEL_POWERFUL=grok-4.6

# For Anthropic instead, set:
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# CLASSIFIER_MODEL=claude-haiku-4-5
# ANSWER_MODEL_ROUTINE=claude-haiku-4-5
# ANSWER_MODEL_HIGH=claude-sonnet-4-6
# ANSWER_MODEL_OPUS=claude-sonnet-4-6

SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.70
REDIS_URL=
CACHE_TTL_SECONDS=3600

RETRIEVAL_TOP_K=4
RETRIEVE_MAX_RETRIES=1
# Chroma L2 distance cutoff — farther chunks = not recognized in KB
RETRIEVAL_MAX_DISTANCE=1.15
# Reject ingest/promote when nearest KB doc is within this L2 distance
INGEST_DEDUP_MAX_DISTANCE=0.45
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

ESCALATE_DEPARTMENTS=legal,hr

# Auth — local JWT (change JWT_SECRET in any shared/deployed environment)
JWT_SECRET=dev-only-change-me-ampcus-helpdesk
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
# Bootstrap admin created only when data/users.json is empty
ADMIN_EMAIL=admin@ampcus.com
ADMIN_PASSWORD=ChangeMeAdmin1!
# Optional override; default is <chroma parent>/users.json
# USERS_PATH=./data/users.json

# Audit / cost attribution / prompt scoring (SQLite)
# AUDIT_DB_PATH=./data/audit.db
PROMPT_SCORE_WINDOW=10
PROMPT_SCORE_RESTRICT_AVG=4.0
PROMPT_TRAINING_GRACE_DAYS=7
TRAINING_BASE_URL=http://127.0.0.1:8080
APP_BASE_URL=http://127.0.0.1:8080
# Escalation / high-severity ticket reminders (admins)
ESCALATION_REMINDER_HOURS=2
ESCALATION_REMINDER_POLL_SECONDS=60
# SMTP — Gmail example (App Password required with 2FA)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_GMAIL@gmail.com
SMTP_PASSWORD=YOUR_16_CHAR_APP_PASSWORD
SMTP_FROM=YOUR_GMAIL@gmail.com

# Chat document assistant
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_TTL_SECONDS=7200
DOCUMENT_STORAGE_DIR=./data/documents
DOCUMENT_FILE_TTL_DAYS=7

# Onboarding reminders (daily at ONBOARDING_REMINDER_HOUR local server time)
ONBOARDING_HR_EMAIL=hr-admin@ampcus.com
ONBOARDING_REMINDER_HOUR=9
ONBOARDING_REMINDER_POLL_SECONDS=300
ONBOARDING_WINDOW_DAYS=7

# Guesthouse reservations
RESERVATION_HR_EMAIL=hr@ampcus.com
RESERVATION_REMINDER_HOUR=9
RESERVATION_REMINDER_POLL_SECONDS=300
RESERVATION_AUTO_APPROVE_HOURS=24

# Office infrastructure — Direct IPP printing (Toshiba IPP port 50081 on office LAN)
PRINT_ENABLED=true
PRINT_IPP_TIMEOUT_SECONDS=30
PRINT_SIMULATE_WHEN_UNREACHABLE=false

# Conference room booking (Microsoft 365 Graph)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
CONFERENCE_ROOM_BOOKING_ENABLED=false

# News headlines during chat loading (NewsAPI — https://newsapi.org)
# News headlines during chat loading (technology + politics only)
NEWSAPI_KEY=
NEWSAPI_CACHE_SECONDS=900

# Fun facts during chat loading — JSON array or .txt (one fact per line)
# FUN_FACTS_PATH=data/fun-facts.json
